package com.example.mypackage;

public class LinkedList {
    private Node head;
    private Node tail;

    public LinkedList() {
        this.head = null;
        this.tail = null;
    }

    public void insertHead(int n) {
        if (isTailOrHeadNull()) {
            initialInsert(n);
            return;
        }
        Node lasthead = this.head;// get the lasthead
        this.head = new Node(n, lasthead);// override the head with the new node and refference the last node
    }

    private void initialInsert(int n) {
        this.head = new Node(n, null);
        this.tail = new Node(n, null);
        return;
    }

    public void insertTail(int n) {
        if (isTailOrHeadNull()) {
            initialInsert(n);
        }
        Node lastTail = this.tail;
        this.tail = new Node(n, lastTail);
    }

    private boolean isTailOrHeadNull() {
        return this.head == null || this.tail == null;
    }

    public boolean search(int n) {
        Node current = this.head;
        while (current != null) {
            if (current.data == n) {
                return true;
            }
            current = current.next;
        }
        return false;
    }

    public void print() {
        Node current = this.head;
        while (current != null) {
            System.out.println(current.data);
            current = current.next;
        }
    }

    public void remove(int index) {
        // ❌ Guard: empty list or invalid index → do nothing
        if (this.head == null || index < 0)
            return;

        // 🎯 Case 1: Removing the head (index 0)
        if (index == 0) {
            this.head = this.head.next;
            // If list is now empty, clear tail too
            if (this.head == null)
                this.tail = null;
            return;
        }

        // 🚶 Traverse to the node BEFORE the one we want to remove
        Node current = this.head;
        for (int i = 0; i < index - 1 && current.next != null; i++) {
            current = current.next;
        }

        // ❌ Index out of bounds → nothing to remove
        if (current.next == null)
            return;

        // 🎯 Case 2: Removing the tail → update tail pointer
        if (current.next == this.tail) {
            this.tail = current;
            this.tail.next = null;
        } else {
            // 🎯 Case 3: Removing middle node → skip over it
            current.next = current.next.next;
        }
    }

}
