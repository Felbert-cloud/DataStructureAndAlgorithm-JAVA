    public void remove(int index) {
        // ❌ Guard: empty list or invalid index → do nothing
        if (this.head == null || index < 0)
            return;

        // 🎯 Case 1: Removing the head (index 0)
        if (index == 0) {
            this.head = this.head.next;
            // If list is now empty, clear tail too
            if (this.head == null)
                this.tail = null;
            return;
        }

        // 🚶 Traverse to the node BEFORE the one we want to remove
        Node current = this.head;
        for (int i = 0; i < index - 1 && current.next != null; i++) {
            current = current.next;
        }

        // ❌ Index out of bounds → nothing to remove
        if (current.next == null)
            return;

        // 🎯 Case 2: Removing the tail → update tail pointer
        if (current.next == this.tail) {
            this.tail = current;
            this.tail.next = null;
        } else {
            // 🎯 Case 3: Removing middle node → skip over it
            current.next = current.next.next;
        }
    }