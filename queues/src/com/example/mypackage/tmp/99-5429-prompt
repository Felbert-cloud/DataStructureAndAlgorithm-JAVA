package com.example.mypackage;

import java.security.DrbgParameters.Capability;
import java.util.ArrayList;

public class Queue {
	private ArrayList<Person> items;
	private int capacity;

	public Queue(int capacity) {
		this.capacity = capacity;
		items = new ArrayList<Person>();
	}

	public void In(Person person) {
		if (this.isFull()) {
			System.out.println("the queue capacity is full ");
		} else {
			items.add(person);
			System.out.println("the person is added on the queue");
		}
	}

	public boolean isFull() {
		if (this.items.size() >= capacity) {
			return true;
		}
		return false;
	}

	public void Out() {
		this.items.remove(0);
	}

	public void PrintQueue() {
		System.out.println("this is the queue: ");
		for (int i = 0; i < this.capacity; i++) {
			System.out.println(i + 1 + ":" + items.get(i).name);
		}
	}

}

